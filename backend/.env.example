# Server-only direct Supabase PostgreSQL connection. URL-encode special password characters.
# Obtain the exact host, username, and database password from Supabase Connect.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
APP_ENV=development

# Firebase Admin for LOCAL development: choose exactly one credential method.
# Use FIREBASE_SERVICE_ACCOUNT_JSON instead when deploying to Render.
FIREBASE_SERVICE_ACCOUNT_PATH=C:/secure/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Optional in development. Production fails closed unless at least one domain
# or explicit email is configured. Use institution-approved values only.
ALLOWED_EMAIL_DOMAINS=
ALLOWED_USER_EMAILS=
REQUIRE_VERIFIED_EMAIL=false

# Optional server-only values for any future Supabase API integration.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=directory-media
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5500,http://127.0.0.1:5500
