# Copy these values into Render's Environment page. Do not upload this file or a service-account key.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"YOUR_FIREBASE_PROJECT_ID",...}
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=directory-media
SUPABASE_ACADEMIC_STORAGE_BUCKET=academic-resources
VAPID_PUBLIC_KEY=your-url-safe-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:verified-admin@example.edu
PRIVACY_CONTACT_EMAIL=privacy@your-institution.edu
PRIVACY_RATE_LIMIT_SALT=replace-with-a-long-random-server-only-value
PRIVACY_REQUEST_RATE_LIMIT=5
PRIVACY_EXPORT_RATE_LIMIT=3
PRIVACY_ADMIN_RATE_LIMIT=120
PRIVACY_RATE_LIMIT_WINDOW_SECONDS=3600
# Use the exact deployed frontend origin, including https:// and no trailing slash.
CORS_ORIGINS=https://your-project.vercel.app
