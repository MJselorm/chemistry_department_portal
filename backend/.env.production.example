# Copy these values into Render's Environment page. Do not upload this file or a service-account key.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"YOUR_FIREBASE_PROJECT_ID",...}
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=directory-media
SUPABASE_PROFILE_STORAGE_BUCKET=profile-photos
SUPABASE_TEST_STORAGE_BUCKET=test
SUPABASE_ACADEMIC_STORAGE_BUCKET=academic-resources
GOOGLE_DRIVE_ROOT_FOLDER_ID=1sPuS7WLpY5k-n_YL7jj6AQs4EiOfrJfq
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"YOUR_GOOGLE_PROJECT_ID",...}
# Use the exact deployed frontend origin, including https:// and no trailing slash.
CORS_ORIGINS=https://your-project.vercel.app
APP_ENV=production
REQUIRE_VERIFIED_EMAIL=true
ALLOWED_EMAIL_DOMAINS=knust.edu.gh,st.knust.edu.gh
ALLOWED_USER_EMAILS=
