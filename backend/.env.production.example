# Copy these values into Render's Environment page. Do not upload this file or a service-account key.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"YOUR_FIREBASE_PROJECT_ID",...}
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=directory-media
# Use the exact deployed frontend origin, including https:// and no trailing slash.
CORS_ORIGINS=https://your-project.vercel.app
