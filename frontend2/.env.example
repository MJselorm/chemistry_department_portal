# Firebase Web app configuration from Firebase Console. These identifiers are
# public client configuration, but do not commit a populated .env file.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# Point this at your FastAPI server.
# Direct:    VITE_API_BASE_URL=http://127.0.0.1:8000
# Via proxy: VITE_API_BASE_URL=/api      (uses the proxy in vite.config.js, no CORS setup needed)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Set to "true" to render the screens with local sample data when the API is unreachable.
VITE_USE_MOCKS=true
